// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`clang armv7 generates a CMake toolchain file 1`] = `
"# Generated by cross-compile-action for armv7-linux-gnueabihf: ARMv7 (hard-float)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "armv7l")

set(CMAKE_C_COMPILER "/usr/bin/clang-21")
set(CMAKE_CXX_COMPILER "/usr/bin/clang++-21")
set(CMAKE_C_COMPILER_TARGET "armv7-linux-gnueabihf")
set(CMAKE_CXX_COMPILER_TARGET "armv7-linux-gnueabihf")
set(CMAKE_C_FLAGS_INIT "-B/usr/arm-linux-gnueabihf/bin")
set(CMAKE_CXX_FLAGS_INIT "-B/usr/arm-linux-gnueabihf/bin")
set(CMAKE_AR "/usr/bin/llvm-ar-21")
set(CMAKE_RANLIB "/usr/bin/llvm-ranlib-21")
set(CMAKE_STRIP "/usr/bin/llvm-strip-21")

set(CMAKE_FIND_ROOT_PATH "/usr/arm-linux-gnueabihf")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_CROSSCOMPILING_EMULATOR "/usr/bin/qemu-arm;-L;/usr/arm-linux-gnueabihf;-cpu;cortex-a8")
"
`;

exports[`clang armv7 generates a Meson cross file 1`] = `
"# Generated by cross-compile-action for armv7-linux-gnueabihf: ARMv7 (hard-float)
[binaries]
c = ['/usr/bin/clang-21', '--target=armv7-linux-gnueabihf', '-B/usr/arm-linux-gnueabihf/bin']
cpp = ['/usr/bin/clang++-21', '--target=armv7-linux-gnueabihf', '-B/usr/arm-linux-gnueabihf/bin']
ar = '/usr/bin/llvm-ar-21'
ranlib = '/usr/bin/llvm-ranlib-21'
strip = '/usr/bin/llvm-strip-21'
exe_wrapper = ['/usr/bin/qemu-arm', '-L', '/usr/arm-linux-gnueabihf', '-cpu', 'cortex-a8']

[host_machine]
system = 'linux'
cpu_family = 'arm'
cpu = 'armv7'
endian = 'little'
"
`;

exports[`clang armv7 generates the environment 1`] = `
{
  "AR": "/usr/bin/llvm-ar-21",
  "CC": "/usr/bin/clang-21 --target=armv7-linux-gnueabihf -B/usr/arm-linux-gnueabihf/bin",
  "CMAKE_TOOLCHAIN_FILE": "/tmp/toolchain.cmake",
  "CROSS_SYSROOT": "/usr/arm-linux-gnueabihf",
  "CROSS_TRIPLE": "armv7-linux-gnueabihf",
  "CXX": "/usr/bin/clang++-21 --target=armv7-linux-gnueabihf -B/usr/arm-linux-gnueabihf/bin",
  "QEMU_CPU": "cortex-a8",
  "QEMU_LD_PREFIX": "/usr/arm-linux-gnueabihf",
  "RANLIB": "/usr/bin/llvm-ranlib-21",
  "STRIP": "/usr/bin/llvm-strip-21",
}
`;

