{
    "name": "cross-compile-action",
    "description": "Cross-compile C and C++ code with clang or GCC, and run the result under QEMU",
    "version": "0.1.0",
    "author": "Elias Kosunen",
    "type": "module",
    "private": true,
    "homepage": "https://github.com/eliaskosunen/cross-compile-action",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliaskosunen/cross-compile-action.git"
    },
    "bugs": {
        "url": "https://github.com/eliaskosunen/cross-compile-action/issues"
    },
    "keywords": [
        "actions",
        "cross-compile",
        "qemu",
        "clang",
        "gcc"
    ],
    "exports": {
        ".": "./dist/index.js"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "bundle": "npm run format:write && npm run package",
        "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
        "format:write": "npx prettier --write .",
        "format:check": "npx prettier --check .",
        "lint": "npx eslint .",
        "local-action": "npx @github/local-action . src/main.ts .env",
        "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
        "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
        "all": "npm run format:write && npm run lint && npm run test && npm run docs && npm run package",
        "docs": "node script/update-readme.ts",
        "e2e:local": "script/e2e-local.sh"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/exec": "^3.0.0",
        "@actions/io": "^3.0.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.63.5"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@github/local-action": "^7.0.1",
        "@jest/globals": "^30.5.2",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.3",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.70.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.9",
        "rimraf": "^6.1.3",
        "rollup": "^4.63.6",
        "ts-jest": "^29.4.14",
        "ts-jest-resolver": "^2.0.1",
        "tslib": "^2.8.1",
        "typescript": "~6.0.3"
    }
}
